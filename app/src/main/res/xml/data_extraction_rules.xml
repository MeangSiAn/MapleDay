<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ 백업/기기 이전 규칙. See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Room DB(mapleday.db)는 Keystore 키로 암호화한 API 키를 담고 있다. Keystore 키는 기기 밖으로 나가지 않으므로
   DB만 복원되면 복호화할 수 없다 → 백업/이전에서 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
